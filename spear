#!/usr/bin/env bash
# solana-spear launcher.
#   - First invocation: opens a NEW Terminal.app window running the chat REPL.
#   - Re-invocation inside that window (SPEAR_EMBEDDED=1): runs harness.py in-place.

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [ "$SPEAR_EMBEDDED" = "1" ]; then
  cd "$DIR" && exec python3 harness.py "$@"
fi

# Build a quoted arg list for the child process
QUOTED_ARGS=""
for a in "$@"; do
  QUOTED_ARGS+=" $(printf %q "$a")"
done

# Write a temp launcher script that the new Terminal window will run
TMP_DIR=$(mktemp -d -t spear-launcher)
LAUNCHER="$TMP_DIR/run.sh"
{
  echo '#!/bin/bash'
  echo 'export SPEAR_EMBEDDED=1'
  echo "cd $(printf %q "$DIR")"
  echo "exec python3 harness.py$QUOTED_ARGS"
} > "$LAUNCHER"
chmod +x "$LAUNCHER"

# Open a new Terminal.app window and run the launcher there
if ! open -a Terminal "$LAUNCHER" 2>/dev/null; then
  echo "[spear] Could not launch Terminal.app; running in the current window instead:"
  exec "$LAUNCHER"
fi

echo "[spear] Launched in a new Terminal window 🗡️"
